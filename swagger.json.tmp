    "/api/payments/pricing": {
      "post": {
        "tags": [
          "Payments"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "CardImages": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  },
                  "CardPrice": {
                    "maximum": 1000000,
                    "minimum": 0,
                    "type": "number",
                    "format": "double"
                  },
                  "VideoPrice": {
                    "maximum": 1000000,
                    "minimum": 0,
                    "type": "number",
                    "format": "double"
                  },
                  "PlatformFeePercent": {
                    "maximum": 100,
                    "minimum": 0,
                    "type": "number",
                    "format": "double"
                  }
                }
              },
              "encoding": {
                "CardImages": {
                  "style": "form"
                },
                "CardPrice": {
                  "style": "form"
                },
                "VideoPrice": {
                  "style": "form"
                },
                "PlatformFeePercent": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "Payments"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
